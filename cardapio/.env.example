# Copiar este arquivo para .env.local e preencher com os valores reais.
# Guia completo: Doc/AUTH.md

# Turso (SQLite)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Opcional — seed do admin (npm run db:seed-admin)
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_PASSWORD=admin1234
# SEED_ADMIN_EMAIL=admin@localhost
# SEED_ADMIN_NAME=Administrador
